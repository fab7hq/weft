#!/bin/sh
# Use this working tree's Weft and RingFrame, and a fab7 checkout's
# configuration and harness files, for testing an edit before it is released;
# or go back to the released Weft. The released Weft is never changed.
#
#   ./bin/reinstall-local             build and use Weft Local
#   ./bin/reinstall-local --release   use the released Weft again
#
# Weft Local is its own app, built here into ~/.fab7/weft-local: on macOS
# "Weft Local.app", com.getfab7.weft.local, linked from Applications beside
# Weft.app, so macOS keeps its folder access apart from the release's. It is
# signed with "Weft Local Dev", a certificate made once in the login keychain,
# so that access holds across rebuilds; the first signing may ask to let
# codesign use its key (Always Allow).
#
# One Weft is used at a time; both share ~/.fab7. Switching points weft and
# ringframe on PATH at it (which "Start at login" runs too), installs its
# configuration, harness and tool files, and restarts the Weft daemon, which
# ends the agents running in it. Each harness's plugin is set up from the
# desktop app, as for a release.
#
# FAB7_DIR overrides where the fab7 checkout is (default: ../fab7).
# WEFT_BIN_DIR overrides where the binaries are linked (default:
# ~/.local/bin), the same variable install.sh reads.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
fab7=${FAB7_DIR:-$(CDPATH= cd -- "$root/../fab7" 2>/dev/null && pwd || true)}
bin_dir=${WEFT_BIN_DIR:-$HOME/.local/bin}
local_dir="$HOME/.fab7/weft-local"
darwin=false
[ "$(uname -s)" = Darwin ] && darwin=true
if $darwin; then
    apps=${WEFT_APPS_DIR:-}
    if [ -z "$apps" ]; then
        if [ -w /Applications ]; then apps=/Applications; else apps="$HOME/Applications"; fi
    fi
fi

link() {
    rm -f "$2.new"
    ln -s "$1" "$2.new"
    mv -f "$2.new" "$2"
}

# The signing identity's hash, the certificate made the first time. Signed by
# it, the app's requirement names the certificate, not the build.
local_identity() {
    cn="Weft Local Dev"
    hash=$(security find-certificate -c "$cn" -Z 2>/dev/null | awk '/^SHA-1/ {print $3; exit}')
    if [ -z "$hash" ]; then
        work=$(mktemp -d)
        cat >"$work/cert.cnf" <<EOF
[req]
distinguished_name = dn
x509_extensions = ext
prompt = no
[dn]
CN = $cn
[ext]
basicConstraints = critical,CA:false
keyUsage = critical,digitalSignature
extendedKeyUsage = critical,codeSigning
EOF
        # The system's LibreSSL: Keychain cannot read a newer OpenSSL's PKCS#12.
        /usr/bin/openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
            -config "$work/cert.cnf" -keyout "$work/key.pem" -out "$work/cert.pem" 2>/dev/null
        /usr/bin/openssl pkcs12 -export -inkey "$work/key.pem" -in "$work/cert.pem" \
            -name "$cn" -passout pass:weft -out "$work/cert.p12"
        security import "$work/cert.p12" -P weft -T /usr/bin/codesign >/dev/null
        rm -rf "$work"
        hash=$(security find-certificate -c "$cn" -Z | awk '/^SHA-1/ {print $3; exit}')
        printf '  signing made "%s" in the login keychain\n' "$cn" >&2
    fi
    printf '%s\n' "$hash"
}

# Configuration, harness and tool files from `bundled`, a fab7 folder as a
# build carries it. `latest`: RingFrame's configuration at fab7's latest
# release first, as install.sh does.
install_files() {
    bundled=$1
    if { [ "${2:-}" = latest ] && "$bin_dir/ringframe" init --global >/dev/null 2>&1; } ||
        "$bin_dir/ringframe" init --global --from "$bundled/ringframe/config" >/dev/null; then
        printf '  config  %s\n' "$(cat "$HOME/.fab7/rf/config/.revision" 2>/dev/null || echo installed)"
    else
        printf '  config  not installed\n'
    fi
    mkdir -p "$HOME/.fab7/weft"
    for part in harnesses tools; do
        [ -d "$bundled/weft/$part" ] || continue
        rm -rf "$HOME/.fab7/weft/$part.new"
        cp -R "$bundled/weft/$part" "$HOME/.fab7/weft/$part.new"
        rm -rf "$HOME/.fab7/weft/$part"
        mv "$HOME/.fab7/weft/$part.new" "$HOME/.fab7/weft/$part"
        printf '  %-7s %s\n' "${part%s}" "$(ls "$HOME/.fab7/weft/$part" | sed -n 's/\.toml$//p' | tr '\n' ' ')"
    done
}

case ${1:-} in
--release)
    if $darwin; then
        app="$apps/Weft.app"
        [ -d "$app" ] && [ ! -L "$app" ] || {
            echo "No released Weft at $app: install it with install.sh." >&2
            exit 1
        }
        programs="$app/Contents/MacOS"
        bundled="$app/Contents/Resources/fab7"
    else
        versions="$HOME/.fab7/weft/versions"
        newest=$(ls "$versions" 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)
        [ -n "$newest" ] || { echo "No released Weft in $versions: install it with install.sh." >&2; exit 1; }
        programs="$versions/$newest"
        bundled="$programs/fab7"
    fi
    mkdir -p "$bin_dir"
    $darwin || link "$programs/weft-desktop" "$bin_dir/weft-desktop"
    link "$programs/weft" "$bin_dir/weft"
    link "$programs/ringframe" "$bin_dir/ringframe"
    printf 'Using the released Weft, %s\n' "$("$bin_dir/weft" --version 2>/dev/null || echo installed)"
    install_files "$bundled" latest
    ;;
'')
    [ -n "$fab7" ] && [ -d "$fab7/products" ] || {
        printf 'No fab7 checkout at %s: set FAB7_DIR if it lives somewhere else.\n' "${fab7:-../fab7}" >&2
        exit 1
    }
    printf 'Building from %s\n' "$root"
    ( cd "$root" && cargo build --release --locked --bin weft --bin ringframe --bin weft-desktop )

    # Made beside the one there, then in its place: a running Weft Local
    # keeps its files until it ends.
    rm -rf "$local_dir.new" "$local_dir.old"
    mkdir -p "$local_dir.new"
    if $darwin; then
        name="Weft Local"
        identity=$(local_identity)
        WEFT_APP_NAME="$name" WEFT_BUNDLE_ID=com.getfab7.weft.local \
            WEFT_SIGN_IDENTITY="$identity" WEFT_HARDENED=0 \
            "$root/bin/bundle" "$root/target/release" "$local_dir.new" "$fab7" >/dev/null
        programs="$local_dir/$name.app/Contents/MacOS"
        bundled="$local_dir/$name.app/Contents/Resources/fab7"
    else
        for program in weft-desktop weft ringframe; do
            cp "$root/target/release/$program" "$local_dir.new/$program"
            chmod 755 "$local_dir.new/$program"
        done
        "$root/bin/fab7-files" "$fab7" "$local_dir.new/fab7"
        programs="$local_dir"
        bundled="$local_dir/fab7"
    fi
    if [ -e "$local_dir" ]; then mv "$local_dir" "$local_dir.old"; fi
    mv "$local_dir.new" "$local_dir"
    rm -rf "$local_dir.old"

    mkdir -p "$bin_dir"
    link "$programs/weft" "$bin_dir/weft"
    link "$programs/ringframe" "$bin_dir/ringframe"
    if $darwin; then
        mkdir -p "$apps"
        if [ -e "$apps/$name.app" ] && [ ! -L "$apps/$name.app" ]; then
            printf '  app     %s is not a link; left alone\n' "$apps/$name.app"
        else
            ln -sfh "$local_dir/$name.app" "$apps/$name.app"
            printf '  app     %s\n' "$apps/$name.app"
        fi
    else
        link "$programs/weft-desktop" "$bin_dir/weft-desktop"
        share="$HOME/.local/share"
        mkdir -p "$share/applications" "$share/icons/hicolor/scalable/apps"
        sed "s|^Exec=weft-desktop|Exec=$bin_dir/weft-desktop|" "$root/assets/linux/weft.desktop" >"$share/applications/weft.desktop"
        cp "$root/assets/weft-mark.svg" "$share/icons/hicolor/scalable/apps/weft.svg"
        printf '  app     %s\n' "$share/applications/weft.desktop"
    fi
    printf 'Using Weft Local, %s\n' "$("$bin_dir/weft" --version 2>/dev/null || echo installed)"
    # From the working tree, not the published tag: the point is to test the
    # edit. `.revision` reads `local` afterwards, which is how you can tell.
    install_files "$bundled"
    ;;
*)
    sed -n '6,7p' "$0" | sed 's/^# *//' >&2
    exit 2
    ;;
esac

# A running daemon is still the other Weft, and only a starting one writes
# ~/.fab7/weft/config.toml. Stopping it ends the agents in its panes.
"$bin_dir/weft" stop | sed 's/^weft: /  weft    /'
nohup "$bin_dir/weft" --serve </dev/null >/dev/null 2>&1 &
printf '  weft    started the daemon; open %s\n' "$([ "${1:-}" = --release ] && echo Weft || echo 'Weft Local')"

case ":$PATH:" in
    *":$bin_dir:"*) ;;
    *) printf '\n%s\n' "Add $bin_dir to your PATH." ;;
esac
