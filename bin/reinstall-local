#!/bin/sh
# Put this working tree's RingFrame and Weft, and a fab7 checkout's
# configuration and harness files, in place, for testing an edit before it is
# released. `install.sh` fetches a published build; this installs what you
# just wrote:
#
#   weft               built here, into ~/.fab7/weft/versions/<version>,
#                      linked from ~/.local/bin/weft
#   ringframe          built here, into ~/.local/bin
#   the configuration  from the fab7 checkout, into ~/.fab7/rf/config
#   the harness files  from the fab7 checkout, into ~/.fab7/weft/harnesses
#   the tool files     from the fab7 checkout, into ~/.fab7/weft/tools
#
# It then restarts the Weft daemon, which ends the agents running in it. Each
# harness's plugin is set up in Weft's RingFrame view (`U`), as for a release.
#
#   ./bin/reinstall-local
#
# FAB7_DIR overrides where the fab7 checkout is (default: ../fab7).
# WEFT_BIN_DIR overrides where the binaries go (default: ~/.local/bin), the
# same variable install.sh reads.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
fab7=${FAB7_DIR:-$(CDPATH= cd -- "$root/../fab7" 2>/dev/null && pwd || true)}
bin_dir=${WEFT_BIN_DIR:-$HOME/.local/bin}

printf 'Building from %s\n' "$root"
( cd "$root" && cargo build --release --locked --bin weft --bin ringframe )

mkdir -p "$bin_dir"
# Weft in its version's folder and `weft` a link to it, as `install.sh` lays
# it out (ADR-0034 D5); RingFrame replaced in place. Each replaced rather than
# written through, so a running binary is undisturbed.
version=$("$root/target/release/weft" --version | sed 's/^weft //')
versions="$HOME/.fab7/weft/versions"
mkdir -p "$versions/$version"
cp "$root/target/release/weft" "$versions/$version/weft.new"
chmod 755 "$versions/$version/weft.new"
mv "$versions/$version/weft.new" "$versions/$version/weft"
rm -f "$bin_dir/weft.new"
ln -s "$versions/$version/weft" "$bin_dir/weft.new"
mv -f "$bin_dir/weft.new" "$bin_dir/weft"
cp "$root/target/release/ringframe" "$bin_dir/ringframe.new"
chmod 755 "$bin_dir/ringframe.new"
mv "$bin_dir/ringframe.new" "$bin_dir/ringframe"
for name in weft ringframe; do
    printf '  binary  %-10s %s\n' "$name" "$("$bin_dir/$name" --version 2>/dev/null || echo installed)"
done

if [ -n "$fab7" ] && [ -d "$fab7/products/ringframe/config" ]; then
    # From the working tree, not the published tag: the point is to test the
    # edit. `.revision` reads `local` afterwards, which is how you can tell.
    "$bin_dir/ringframe" init --global --from "$fab7/products/ringframe/config" >/dev/null
    printf '  config  %s\n' "$(cat "${HOME}/.fab7/rf/config/.revision" 2>/dev/null || echo installed)"
else
    printf '  config  skipped: no fab7 checkout at %s\n' "${fab7:-../fab7}"
    printf '          set FAB7_DIR if it lives somewhere else\n'
fi

if [ -n "$fab7" ] && [ -d "$fab7/products/weft/harnesses" ]; then
    # Weft's harness files, replaced whole, as `install.sh` does.
    harnesses="$HOME/.fab7/weft/harnesses"
    mkdir -p "$HOME/.fab7/weft"
    rm -rf "$harnesses.new"
    cp -R "$fab7/products/weft/harnesses" "$harnesses.new"
    rm -rf "$harnesses"
    mv "$harnesses.new" "$harnesses"
    printf '  harness %s\n' "$(ls "$harnesses" | sed 's/\.toml$//' | tr '\n' ' ')"
    # The tool files, the same way (ADR-0023).
    if [ -d "$fab7/products/weft/tools" ]; then
        tools="$HOME/.fab7/weft/tools"
        rm -rf "$tools.new"
        cp -R "$fab7/products/weft/tools" "$tools.new"
        rm -rf "$tools"
        mv "$tools.new" "$tools"
        printf '  tool %s\n' "$(ls "$tools" | sed 's/\.toml$//' | tr '\n' ' ')"
    fi
else
    printf '  harness skipped: no %s/products/weft/harnesses\n' "${fab7:-../fab7}"
fi

# A running daemon is still the old binary, and only a starting one writes
# ~/.fab7/weft/config.toml. Stopping it ends the agents in its panes.
"$bin_dir/weft" stop | sed 's/^weft: /  weft    /'
nohup "$bin_dir/weft" --serve </dev/null >/dev/null 2>&1 &
printf '  weft    started the new daemon\n'

case ":$PATH:" in
    *":$bin_dir:"*) ;;
    *) printf '\n%s\n' "Add $bin_dir to your PATH." ;;
esac
