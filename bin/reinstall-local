#!/bin/sh
# Put this working tree's RingFrame and Weft, and a fab7 checkout's
# configuration and harness files, in place, for testing an edit before it is
# released. `install.sh` fetches a published build; this installs what you
# just wrote:
#
#   the app            built here, into ~/.fab7/weft/versions/<version>, laid
#                      out as install.sh lays out a release: Weft.app linked
#                      from Applications on macOS, the desktop entry on Linux;
#                      weft and ringframe on PATH link into it
#   the configuration  from the fab7 checkout, into ~/.fab7/rf/config
#   the harness files  from the fab7 checkout, into ~/.fab7/weft/harnesses
#   the tool files     from the fab7 checkout, into ~/.fab7/weft/tools
#
# It then restarts the Weft daemon, which ends the agents running in it. Each
# harness's plugin is set up from the desktop app, as for a release.
#
#   ./bin/reinstall-local
#
# FAB7_DIR overrides where the fab7 checkout is (default: ../fab7).
# WEFT_BIN_DIR overrides where the binaries go (default: ~/.local/bin), the
# same variable install.sh reads.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
fab7=${FAB7_DIR:-$(CDPATH= cd -- "$root/../fab7" 2>/dev/null && pwd || true)}
bin_dir=${WEFT_BIN_DIR:-$HOME/.local/bin}

printf 'Building from %s\n' "$root"
( cd "$root" && cargo build --release --locked --bin weft --bin ringframe --bin weft-desktop )

mkdir -p "$bin_dir"
# Laid out as `install.sh` lays out a release: this version in its own folder,
# so a running Weft keeps its own; on macOS Weft.app there, linked from
# Applications, with `weft` and `ringframe` linking into it; on Linux the three
# programs there, linked from the bin folder, with the desktop entry and icon.
version=$("$root/target/release/weft" --version | sed 's/^weft //')
folder="$HOME/.fab7/weft/versions/$version"
rm -rf "$folder.new"
mkdir -p "$folder.new"
if [ "$(uname -s)" = Darwin ]; then
    programs="Weft.app/Contents/MacOS"
    "$root/bin/bundle" "$root/target/release" "$folder.new" >/dev/null
    ln -s "$programs/weft" "$folder.new/weft"
else
    programs=.
    for name in weft-desktop weft ringframe; do
        cp "$root/target/release/$name" "$folder.new/$name"
        chmod 755 "$folder.new/$name"
    done
fi
# The same version again: moved aside first, so a running Weft keeps its files.
if [ -e "$folder" ]; then rm -rf "$folder.old"; mv "$folder" "$folder.old"; fi
mv "$folder.new" "$folder"
rm -rf "$folder.old"
link() {
    rm -f "$2.new"
    ln -s "$1" "$2.new"
    mv -f "$2.new" "$2"
}
link "$folder/weft" "$bin_dir/weft"
link "$folder/$programs/ringframe" "$bin_dir/ringframe"
if [ "$(uname -s)" = Darwin ]; then
    apps=${WEFT_APPS_DIR:-}
    if [ -z "$apps" ]; then
        if [ -w /Applications ]; then apps=/Applications; else apps="$HOME/Applications"; fi
    fi
    mkdir -p "$apps"
    if [ -e "$apps/Weft.app" ] && [ ! -L "$apps/Weft.app" ]; then
        printf '  app     %s is not one Weft installed; left alone\n' "$apps/Weft.app"
    else
        ln -sfh "$folder/Weft.app" "$apps/Weft.app"
        printf '  app     %s -> %s\n' "$apps/Weft.app" "$folder/Weft.app"
    fi
else
    link "$folder/weft-desktop" "$bin_dir/weft-desktop"
    share="$HOME/.local/share"
    mkdir -p "$share/applications" "$share/icons/hicolor/scalable/apps"
    sed "s|^Exec=weft-desktop|Exec=$bin_dir/weft-desktop|" "$root/assets/linux/weft.desktop" >"$share/applications/weft.desktop"
    cp "$root/assets/weft-mark.svg" "$share/icons/hicolor/scalable/apps/weft.svg"
    printf '  app     %s\n' "$share/applications/weft.desktop"
fi
for name in weft ringframe; do
    printf '  binary  %-12s %s\n' "$name" "$("$bin_dir/$name" --version 2>/dev/null || echo installed)"
done

if [ -n "$fab7" ] && [ -d "$fab7/products/ringframe/config" ]; then
    # From the working tree, not the published tag: the point is to test the
    # edit. `.revision` reads `local` afterwards, which is how you can tell.
    "$bin_dir/ringframe" init --global --from "$fab7/products/ringframe/config" >/dev/null
    printf '  config  %s\n' "$(cat "${HOME}/.fab7/rf/config/.revision" 2>/dev/null || echo installed)"
else
    printf '  config  skipped: no fab7 checkout at %s\n' "${fab7:-../fab7}"
    printf '          set FAB7_DIR if it lives somewhere else\n'
fi

if [ -n "$fab7" ] && [ -d "$fab7/products/weft/harnesses" ]; then
    # Weft's harness files, replaced whole, as `install.sh` does.
    harnesses="$HOME/.fab7/weft/harnesses"
    mkdir -p "$HOME/.fab7/weft"
    rm -rf "$harnesses.new"
    cp -R "$fab7/products/weft/harnesses" "$harnesses.new"
    rm -rf "$harnesses"
    mv "$harnesses.new" "$harnesses"
    printf '  harness %s\n' "$(ls "$harnesses" | sed 's/\.toml$//' | tr '\n' ' ')"
    # The tool files, the same way.
    if [ -d "$fab7/products/weft/tools" ]; then
        tools="$HOME/.fab7/weft/tools"
        rm -rf "$tools.new"
        cp -R "$fab7/products/weft/tools" "$tools.new"
        rm -rf "$tools"
        mv "$tools.new" "$tools"
        printf '  tool %s\n' "$(ls "$tools" | sed 's/\.toml$//' | tr '\n' ' ')"
    fi
else
    printf '  harness skipped: no %s/products/weft/harnesses\n' "${fab7:-../fab7}"
fi

# A running daemon is still the old binary, and only a starting one writes
# ~/.fab7/weft/config.toml. Stopping it ends the agents in its panes.
"$bin_dir/weft" stop | sed 's/^weft: /  weft    /'
nohup "$bin_dir/weft" --serve </dev/null >/dev/null 2>&1 &
printf '  weft    started the new daemon\n'

case ":$PATH:" in
    *":$bin_dir:"*) ;;
    *) printf '\n%s\n' "Add $bin_dir to your PATH." ;;
esac
